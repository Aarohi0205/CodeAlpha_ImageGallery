body{
  margin:0;
  padding:20px;
  font-family:Arial, sans-serif;
  background:#f2f2f2;
  text-align:center;
}

h1{
  margin-bottom:20px;
}

.gallery{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(250px,1fr));
  gap:20px;
}

.gallery img{
  width:100%;
  border-radius:10px;
  box-shadow:0 0 10px rgba(0,0,0,0.2);
  transition:0.3s;
  cursor:pointer;
}

.gallery img:hover{
  transform:scale(1.05);
}